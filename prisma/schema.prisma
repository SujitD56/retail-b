// Ilkal Threads — Marketplace API
// PostgreSQL schema. Enum values are @map()'d to the exact lowercase/spaced
// strings `types/index.ts` on the frontend already expects (e.g. "in transit",
// "Cotton Ilkal"), so API responses need zero string-transform layer to match
// the existing frontend contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER @map("customer")
  RETAILER @map("retailer")
  ADMIN    @map("admin")
}

enum RetailerStatus {
  APPROVED  @map("approved")
  PENDING   @map("pending")
  REJECTED  @map("rejected")
  SUSPENDED @map("suspended")
}

enum WeaveType {
  COTTON_ILKAL       @map("Cotton Ilkal")
  SILK_COTTON        @map("Silk Cotton")
  TRADITIONAL_ILKAL  @map("Traditional Ilkal")
  CONTEMPORARY_ILKAL @map("Contemporary Ilkal")
  WEDDING_SAREE      @map("Wedding Saree")
  FESTIVE_SAREE      @map("Festive Saree")
}

// Canonical lifecycle state the retailer/admin actually set. Display-only
// badges like "Out of Stock" / "Low Stock" are DERIVED from stockCount at the
// service layer, not stored redundantly — see products/products.mappers.ts.
enum ProductLifecycle {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
}

enum OrderStatus {
  PROCESSING @map("processing")
  SHIPPED    @map("shipped")
  IN_TRANSIT @map("in transit")
  DELIVERED  @map("delivered")
  CANCELLED  @map("cancelled")
}

// Superset of OrderStatus — a tracking timeline also has a "placed" step,
// which is never a resting order status. Kept as its own enum since Prisma
// can't compose one enum from another.
enum TrackingStatus {
  PLACED     @map("placed")
  PROCESSING @map("processing")
  SHIPPED    @map("shipped")
  IN_TRANSIT @map("in transit")
  DELIVERED  @map("delivered")
  CANCELLED  @map("cancelled")
}

enum PaymentMethod {
  UPI        @map("upi")
  CARD       @map("card")
  NETBANKING @map("netbanking")
  COD        @map("cod")
}

enum PaymentStatus {
  PENDING @map("pending")
  PAID    @map("paid")
  FAILED  @map("failed")
}

enum EventStatus {
  LIVE     @map("live")
  UPCOMING @map("upcoming")
  ENDED    @map("ended")
}

enum EntryStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum AssetPurpose {
  PRODUCT_IMAGE
  RETAILER_LOGO
  RETAILER_COVER
  RETAILER_DOCUMENT
  EVENT_BANNER
  EVENT_ENTRY
  AVATAR
}

// ---------- Identity ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  avatarUrl    String?
  mfaSecret    String? // TOTP secret (admin-only), encrypted at rest — see lib/crypto.ts
  mfaEnabled   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses           Address[]
  retailerProfile     Retailer?
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  orders              Order[]
  eventVotes          EventVote[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  reviews             Review[]
  uploadedAssets      Asset[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  line1      String
  city       String
  state      String
  postalCode String
  phone      String
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------- Retailers ----------

model Retailer {
  id          String         @id @default(cuid())
  slug        String         @unique
  userId      String         @unique
  name        String
  logoUrl     String?
  coverUrl    String?
  location    String
  verified    Boolean        @default(false)
  rating      Float          @default(0)
  reviewCount Int            @default(0)
  productCount Int           @default(0)
  memberSince DateTime       @default(now())
  bio         String         @db.Text
  specialties WeaveType[]
  status      RetailerStatus @default(PENDING)
  totalSales  Decimal        @default(0) @db.Decimal(14, 2)

  // Optional richer profile content
  heroImageUrl     String?
  storyImageUrl    String?
  foundedYear      Int?
  storyTitle       String?
  storyParagraphs  String[]
  ordersFulfilled  Int      @default(0)

  // Registration application fields (5-step onboarding form)
  storeDescription String? @db.Text
  primaryCategory  String?
  pincode          String?
  registrationType String?
  gstin            String?
  gstExempt        Boolean  @default(false)
  pan              String?
  registeredAddress String?
  yearsInBusiness   String?
  monthlyRevenue    String?

  // Payout details — demo-grade storage. In production, route bank/UPI
  // details through a PCI-compliant processor (Razorpay/Stripe Connect) and
  // never persist raw account numbers; accountNumberEnc is AES-encrypted via
  // lib/crypto.ts as a stopgap, not a substitute for tokenization.
  accountHolderName String?
  bankName          String?
  accountNumberEnc  String?
  ifsc              String?
  accountType       String?
  upi               String?
  payoutCycle       String?
  rejectionReason   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  reviews        Review[]         @relation("RetailerReviews")
  eventEntries   EventEntry[]
  hallOfFame     HallOfFameEntry[]
  orderItems     OrderItem[]

  @@map("retailers")
}

// ---------- Catalog ----------

model Category {
  slug        String    @id
  name        WeaveType @unique
  description String
  imageUrl    String

  @@map("categories")
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  retailerId      String
  weaveType       WeaveType
  price           Decimal          @db.Decimal(12, 2)
  compareAtPrice  Decimal?         @db.Decimal(12, 2)
  color           String
  borderType      String
  material        String
  lengthWidth     String
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  stockCount      Int              @default(0)
  tags            String[]
  description     String           @db.Text
  status          ProductLifecycle @default(ACTIVE)
  collectionLabel String? // free-text "merchandising collection" shown in retailer catalog table
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  retailer          Retailer            @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  reviews            Review[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  eventEntries       EventEntry[]
  collectionProducts CollectionProduct[]

  @@index([retailerId])
  @@index([weaveType])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Collection {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  eyebrow       String?
  description   String   @db.Text
  coverUrl      String
  heroImageUrl  String?
  createdAt     DateTime @default(now())

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

// One Review model serves both product reviews and retailer (storefront)
// reviews — exactly one of productId/retailerId is set per row, enforced in
// the service layer (reviews.service.ts) rather than a DB constraint Prisma
// can't express directly.
model Review {
  id         String   @id @default(cuid())
  productId  String?
  retailerId String?
  authorId   String?
  authorName String
  verified   Boolean  @default(false)
  rating     Int
  title      String?
  body       String   @db.Text
  createdAt  DateTime @default(now())

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer Retailer? @relation("RetailerReviews", fields: [retailerId], references: [id], onDelete: Cascade)
  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([retailerId])
  @@map("reviews")
}

// ---------- Cart / Wishlist ----------

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ---------- Orders ----------

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique // e.g. ORD-88213 — the customer/admin-facing id
  userId             String?
  guestEmail         String?
  status             OrderStatus   @default(PROCESSING)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  subtotal           Decimal       @db.Decimal(12, 2)
  shipping           Decimal       @db.Decimal(12, 2)
  tax                Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  shippingAddress    Json // denormalized snapshot at time of order
  placedAt           DateTime      @default(now())
  estimatedDelivery  DateTime

  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  tracking OrderTrackingStep[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  retailerId      String // denormalized so retailer order queries never need a join through Product
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(12, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([retailerId])
  @@map("order_items")
}

model OrderTrackingStep {
  id        String         @id @default(cuid())
  orderId   String
  status    TrackingStatus
  label     String
  timestamp DateTime?
  complete  Boolean        @default(false)
  position  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_tracking_steps")
}

// ---------- Events (Style Challenge / gamified leaderboard) ----------

model MarketplaceEvent {
  id                 String      @id @default(cuid())
  slug               String      @unique
  title              String
  tagline            String
  bannerUrl          String
  status             EventStatus @default(UPCOMING)
  startsAt           DateTime
  endsAt             DateTime
  prizePool          String
  description        String      @db.Text
  category           String?
  registrationStart  DateTime?
  registrationEnd    DateTime?
  submissionStart    DateTime?
  submissionEnd      DateTime?
  votingStart        DateTime?
  votingEnd          DateTime?
  entryFormat        String?
  maxEntriesPerRetailer Int?
  // Flexible admin-authored config (toggles, prize copy, jury panel) — UI
  // presentation config, not core transactional data, so JSONB over a dozen
  // narrow columns is the pragmatic call here.
  config             Json?
  createdAt          DateTime    @default(now())

  entries    EventEntry[]
  hallOfFame HallOfFameEntry[]

  @@map("marketplace_events")
}

model EventEntry {
  id          String      @id @default(cuid())
  eventId     String
  retailerId  String
  productId   String
  title       String
  imageUrl    String
  videoUrl    String?
  votes       Int         @default(0)
  status      EntryStatus @default(APPROVED)
  submittedAt DateTime    @default(now())

  event    MarketplaceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  retailer Retailer         @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  votesCast EventVote[]

  @@index([eventId])
  @@index([retailerId])
  @@map("event_entries")
}

model EventVote {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry EventEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@map("event_votes")
}

model HallOfFameEntry {
  id         String @id @default(cuid())
  eventId    String?
  year       Int
  entryTitle String
  retailerId String
  imageUrl   String
  votes      Int

  event    MarketplaceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  retailer Retailer          @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@map("hall_of_fame_entries")
}

// ---------- Admin activity feed ----------

// Populated by an event-bus subscriber (modules/admin/activityLog.subscribers.ts)
// reacting to domain events published by OTHER modules (order.placed,
// retailer.registered, …) — the admin dashboard's live activity feed is a
// real read model built from those events, not hand-authored copy.
model ActivityLogEntry {
  id        String   @id @default(cuid())
  type      String // RETAILER | ORDER | PRODUCT | EVENT | SYSTEM
  message   String
  createdAt DateTime @default(now())

  @@map("activity_log_entries")
}

// ---------- Uploads bookkeeping ----------

model Asset {
  id             String       @id @default(cuid())
  key            String       @unique // S3 object key
  url            String
  purpose        AssetPurpose
  uploadedByUserId String?
  createdAt      DateTime     @default(now())

  uploadedBy User? @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@map("assets")
}
